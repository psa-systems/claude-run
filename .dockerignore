# Version control
.git
.gitignore
.gitattributes
.gitmodules

# Forgejo CI (built outside the image)
.forgejo

# Vendored shared just tooling (local-dev only, no role in the image build)
common

# Build artifacts (regenerated inside the image)
target
**/*.rs.bk

# Editor / IDE
.idea
.vscode
.zed
*.swp
*.swo

# OS noise
.DS_Store
Thumbs.db

# Project-internal docs and tooling that have no role in the build
.claude
.devcontainer
CLAUDE.md
README.md
LICENSE.md
docs

# Runtime state generated by users of the binary, never relevant to the build.
# CLAUDE-247: the shipped action YAML is the exception, baked into the runtime
# image at /usr/share/claude-run/actions and seeded into an empty config volume
# by the entrypoint. SCHEMA.md stays excluded: it is documentation, not an action.
actions
!actions/*.yml
scripts
